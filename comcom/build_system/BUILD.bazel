load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "build_system",
    srcs = [
        "bazel.rs",
        "cmake/cache.rs",
        "cmake/mod.rs",
        "cmake/parse.rs",
        "cmake/generator/make.rs",
        "cmake/generator/mod.rs",
        "cmake/generator/ninja.rs",
        "custom.rs",
        "exit.rs",
        "lib.rs",
        "make/mod.rs",
        "ptrace/classify.rs",
        "ptrace/mod.rs",
        "ptrace/pid.rs",
        "ptrace/trace.rs",
        "ptrace/warnings.rs",
    ],
    deps = [
        "//comcom/common/semver",
        "//comcom/db",
        "//comcom/output",
        "@crates//:libc",
        "@crates//:miette",
        "@crates//:shlex",
    ],
)

rust_test(
    name = "build_system_test",
    size = "small",
    crate = ":build_system",
    data = [
        "cmake/generator/testdata/failing_make.sh",
        "cmake/generator/testdata/fake_make.sh",
    ],
    deps = ["@crates//:tempfile"],
)
