"""Development module for comcom: builds the CLI and runs its tests."""

module(name = "comcom_dev")

bazel_dep(name = "rules_rust", version = "0.75.0")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    versions = ["1.99.1"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.spec(features = ["fancy"], package = "miette", version = "7")
crate.spec(features = ["derive"], package = "clap", version = "4")
crate.spec(package = "libc", version = "0.2")
crate.spec(features = ["derive"], package = "serde", version = "1")
crate.spec(package = "serde_json", version = "1")
crate.spec(package = "shlex", version = "1")
crate.spec(package = "tempfile", version = "3")
crate.from_specs()
use_repo(crate, "crates")
